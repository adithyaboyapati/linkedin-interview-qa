# Copy this file to .env and fill in the two required values for a real LinkedIn run.
# Offline testing does not need them:  .venv/bin/python -m app.main demo

# Profile whose accessible posts should be collected.
# Example: https://www.linkedin.com/in/example-profile/
LINKEDIN_PROFILE_URL=

# OpenAI-compatible LLM (required for extract / run, not for demo)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Storage
DATABASE_PATH=data/linkedin_qa.db

# Persistent Playwright profile (manual login is stored here)
BROWSER_USER_DATA_DIR=data/browser_profile

# Collection — top N accessible posts
MAX_POSTS=100
MAX_SCROLLS=80
SCROLL_PAUSE_MS=2000
MAX_IDLE_SCROLLS=3
HEADLESS=false
LOGIN_TIMEOUT_SECONDS=300
